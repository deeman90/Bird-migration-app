# ==============================================================================
# BIRD MIGRATION APP (BMA) - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env on your server or configure these variables in your
# hosting provider's environment variables dashboard (e.g. Cloud Run, Render, Vercel).
# NEVER commit your actual .env file with secrets to GitHub.
# ==============================================================================

# Application URL (automatically set on Cloud Run / hosting platforms)
APP_URL=http://localhost:3000

# Google Gemini AI (Server-Side Only - Used for Species Vision & Validation)
# Retrieve from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Backend Server Environment)
# The backend proxies data operations or serves public configuration dynamically.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Paystack Gateway (Server-Side Payment & Verification)
# Retrieve from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Flutterwave Gateway (Server-Side Payment Verification)
# Retrieve from: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
